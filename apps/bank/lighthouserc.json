{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/app?demo",
        "http://localhost:4174/app/activity?demo",
        "http://localhost:4174/app/pay?demo",
        "http://localhost:4174/app/cards?demo"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "startServerCommand": "npm run preview -- --strictPort",
      "startServerReadyPattern": "4174"
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse"
    }
  }
}
