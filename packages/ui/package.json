{
  "name": "@nisakhantalib/my-ui-kit",
  "version": "0.1.0",
  "description": "Accessible, composable React components (WCAG 2.2 AA) with pluggable analytics",
  "license": "MIT",
  "author": "Khairunnisa Khan Binti Talib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nisakhantalib/my-ui-kit.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "components",
    "accessibility",
    "a11y",
    "design-system",
    "typescript",
    "design-tokens",
    "wcag",
    "adobe-analytics"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/my-ui-kit.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "build": "npm run tokens:check && vite build && tsc -p tsconfig.build.json && node scripts/strip-css-from-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:package",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./tokens.json ./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
