{
  "name": "@nisakhantalib/my-ui-kit",
  "version": "0.1.0",
  "description": "Accessible, composable React components (WCAG 2.2 AA) with pluggable analytics",
  "license": "MIT",
  "author": "Khairunnisa Khan Binti Talib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nisakhantalib/my-ui-kit.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "components",
    "accessibility",
    "a11y",
    "design-system",
    "typescript",
    "design-tokens",
    "wcag",
    "adobe-analytics"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/my-ui-kit.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "build": "npm run tokens:check && vite build && tsc -p tsconfig.build.json && node scripts/strip-css-from-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:package",
    "check:package": "publint --strict && attw --pack . --profile esm-only --entrypoints .",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "size": "size-limit",
    "test:storybook": "node scripts/storybook-a11y.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "size-limit": [
    {
      "name": "Button only (tree-shaken)",
      "path": "dist/index.js",
      "import": "{ Button }",
      "limit": "1 kB"
    },
    {
      "name": "Form controls",
      "path": "dist/index.js",
      "import": "{ TextField, Select, Checkbox, RadioGroup, Radio }",
      "limit": "2 kB"
    },
    {
      "name": "Banking set (AmountInput, OTPInput, Combobox, DataTable, KitProvider)",
      "path": "dist/index.js",
      "import": "{ AmountInput, OTPInput, Combobox, DataTable, KitProvider }",
      "limit": "6 kB"
    },
    {
      "name": "Whole library (23 components, 3 languages)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "12 kB"
    },
    {
      "name": "Styles (all components, 3 brands x 2 modes)",
      "path": "dist/my-ui-kit.css",
      "limit": "5 kB",
      "rolldown": false
    }
  ]
}
