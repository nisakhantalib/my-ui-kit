{
  "$description": "Colour pairs that must meet WCAG contrast in every brand and mode. The token build fails if any pair falls short. 4.5 is for text (1.4.3); 3 is for UI parts and focus (1.4.11).",
  "pairs": [
    ["text", "bg", 4.5],
    ["text", "surface", 4.5],
    ["text-muted", "bg", 4.5],
    ["text-muted", "surface", 4.5],
    ["primary", "bg", 4.5],
    ["primary", "surface", 4.5],
    ["on-primary", "primary", 4.5],
    ["on-primary", "primary-hover", 4.5],
    ["on-primary", "accent", 4.5],
    ["on-brand-surface", "brand-surface", 4.5],
    ["on-brand-surface", "brand-surface-end", 4.5],
    ["danger", "bg", 4.5],
    ["danger", "surface", 4.5],
    ["on-danger", "danger", 4.5],
    ["success", "bg", 4.5],
    ["warning", "bg", 4.5],
    ["accent", "bg", 3],
    ["border", "bg", 3],
    ["focus", "bg", 3],
    ["focus", "surface", 3]
  ]
}
