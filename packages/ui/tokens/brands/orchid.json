{
  "$description": "Orchid: retail-banking brand (Orchid Bank, the fictional bank in the reference app). \"Intaglio\": treasury green and paper, with banknote-style engraving as the signature; ink for text, jade for links and gains, mint on the dark brand surface.",
  "font": {
    "$type": "fontFamily",
    "$value": ["Hanken Grotesk Variable", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
  },
  "font-display": {
    "$type": "fontFamily",
    "$description": "Headings and headline amounts",
    "$value": ["Archivo Variable", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
  },
  "font-mono": {
    "$type": "fontFamily",
    "$description": "Account numbers, card numbers and reference IDs",
    "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
  },
  "radius": {
    "$type": "dimension",
    "$value": "12px"
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{palette.white}",
      "$extensions": {
        "mode": {
          "dark": "{palette.ledger.850}"
        }
      }
    },
    "surface": {
      "$value": "{palette.paper.100}",
      "$extensions": {
        "mode": {
          "dark": "{palette.ledger.950}"
        }
      }
    },
    "text": {
      "$value": "{palette.ledger.900}",
      "$extensions": {
        "mode": {
          "dark": "{palette.ledger.25}"
        }
      }
    },
    "text-muted": {
      "$value": "{palette.ledger.600}",
      "$extensions": {
        "mode": {
          "dark": "{palette.ledger.300}"
        }
      }
    },
    "border": {
      "$value": "{palette.ledger.400}",
      "$extensions": {
        "mode": {
          "dark": "{palette.ledger.500}"
        }
      }
    },
    "primary": {
      "$value": "{palette.treasury.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.mint.300}"
        }
      }
    },
    "primary-hover": {
      "$value": "{palette.treasury.600}",
      "$extensions": {
        "mode": {
          "dark": "{palette.mint.200}"
        }
      }
    },
    "on-primary": {
      "$value": "{palette.white}",
      "$extensions": {
        "mode": {
          "dark": "{palette.treasury.900}"
        }
      }
    },
    "accent": {
      "$value": "{palette.jade.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.mint.400}"
        }
      }
    },
    "brand-surface": {
      "$value": "{palette.treasury.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.treasury.700}"
        }
      }
    },
    "brand-surface-end": {
      "$value": "{palette.treasury.800}",
      "$extensions": {
        "mode": {
          "dark": "{palette.treasury.900}"
        }
      }
    },
    "on-brand-surface": {
      "$value": "{palette.white}"
    },
    "brand-accent": {
      "$value": "{palette.mint.300}",
      "$description": "Highlights on brand-surface: gains, chart lines, engraving"
    },
    "danger": {
      "$value": "{palette.red.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.red.300}"
        }
      }
    },
    "on-danger": {
      "$value": "{palette.white}",
      "$extensions": {
        "mode": {
          "dark": "{palette.red.990}"
        }
      }
    },
    "success": {
      "$value": "{palette.green.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.green.300}"
        }
      }
    },
    "warning": {
      "$value": "{palette.amber.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.amber.300}"
        }
      }
    },
    "focus": {
      "$value": "{palette.blue.700}",
      "$extensions": {
        "mode": {
          "dark": "{palette.blue.400}"
        }
      }
    },
    "backdrop": {
      "$value": "{palette.backdrop}"
    }
  },
  "component": {
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Squared-off buttons: calmer and more formal than pills"
      }
    },
    "control": {
      "height": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "20px"
      }
    }
  }
}
