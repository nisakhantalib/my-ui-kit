{
  "$description": "My UI Kit design tokens. Source of truth for every platform: run `npm run tokens` to regenerate src/tokens.css (web) and src/tokens.ts (JS / React Native / Capacitor). Format follows the W3C Design Tokens Community Group shape ($value, $type, $description); dark-mode values live in $extensions.mode.dark. Contrast ratios are against bg in the same mode.",
  "font": {
    "$type": "fontFamily",
    "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
  },
  "radius": { "$type": "dimension", "$value": "10px" },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" }
  },
  "color": {
    "$type": "color",
    "bg": { "$value": "#ffffff", "$extensions": { "mode": { "dark": "#12151c" } }, "$description": "Page background" },
    "surface": {
      "$value": "#f6f7f9",
      "$extensions": { "mode": { "dark": "#1b1f29" } },
      "$description": "Cards and raised areas"
    },
    "text": {
      "$value": "#14171f",
      "$extensions": { "mode": { "dark": "#eef0f4" } },
      "$description": "17.9:1 light, 15.9:1 dark"
    },
    "text-muted": {
      "$value": "#4a5163",
      "$extensions": { "mode": { "dark": "#b3b9c6" } },
      "$description": "7.9:1 light, 9.6:1 dark"
    },
    "border": {
      "$value": "#8a90a0",
      "$extensions": { "mode": { "dark": "#6b7385" } },
      "$description": "Input borders: ≥ 3:1 (WCAG 1.4.11)"
    },
    "primary": { "$value": "#0b5cad", "$extensions": { "mode": { "dark": "#7ab8f5" } }, "$description": "6.7:1 light" },
    "primary-hover": { "$value": "#084a8c", "$extensions": { "mode": { "dark": "#a3cdf8" } } },
    "on-primary": {
      "$value": "#ffffff",
      "$extensions": { "mode": { "dark": "#0a1626" } },
      "$description": "Text on primary"
    },
    "danger": { "$value": "#b42318", "$extensions": { "mode": { "dark": "#ff8a7a" } }, "$description": "6.6:1 light" },
    "on-danger": {
      "$value": "#ffffff",
      "$extensions": { "mode": { "dark": "#2a0905" } },
      "$description": "Text on danger"
    },
    "success": { "$value": "#1a7f37", "$extensions": { "mode": { "dark": "#6fdd8b" } }, "$description": "5.1:1 light" },
    "warning": { "$value": "#9a6700", "$extensions": { "mode": { "dark": "#f0b72f" } }, "$description": "4.9:1 light" },
    "focus": {
      "$value": "#b45309",
      "$extensions": { "mode": { "dark": "#f5a524" } },
      "$description": "Focus ring: ≥ 3:1 against bg and surface in both modes (WCAG 1.4.11, 2.4.13)"
    },
    "backdrop": { "$value": "rgb(10 14 22 / 0.55)", "$description": "Behind modal dialogs" }
  }
}
